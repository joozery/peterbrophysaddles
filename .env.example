# Cloudflare R2 — image uploads from the admin panel.
# Copy to .env.local and fill in. Never commit .env.local.
# Cloudflare dashboard → R2 → Manage API tokens → Create token with "Object Read & Write" on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket, no trailing slash: the r2.dev URL or your custom domain.
# e.g. https://pub-xxxxxxxx.r2.dev  or  https://images.peterbrophysaddles.com.au
R2_PUBLIC_URL=
